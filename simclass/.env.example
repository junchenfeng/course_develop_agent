# SimClass 环境变量配置

# ─── LLM (OpenRouter) ────────────────────────────────────────
# 必填：OpenRouter API Key
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Agent 模型（用于学生角色扮演，需要低延迟）
SIMCLASS_AGENT_MODEL=openai/gpt-4o-mini

# 分析模型（用于课后教学分析，需要强推理）
SIMCLASS_ANALYZER_MODEL=openai/gpt-4o

# ─── STT: SeedASR (火山引擎，默认) ──────────────────────────
SIMCLASS_STT_PROVIDER=seedasr
SEED_ASR_APP_ID=
SEED_ASR_TOKEN=
SEED_ASR_CLUSTER_ID=volcengine_streaming_common
SEED_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel

# ─── STT: Deepgram (备选) ───────────────────────────────────
# 如要使用 Deepgram，设置 SIMCLASS_STT_PROVIDER=deepgram
# DEEPGRAM_API_KEY=

# ─── 录制 ────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg

# ─── 存储 ────────────────────────────────────────────────────
SIMCLASS_SESSIONS_DIR=./sessions
